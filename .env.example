# Optional. The easiest way to add API keys is the Settings tab in the app.
# Keys here are only read the first time the app starts.

BRAIN_OWNER_NAME=Your Name
BRAIN_PORT=8765

# Free keys (any one is enough to start):
#   Google Gemini: https://aistudio.google.com/apikey
#   Groq:          https://console.groq.com/keys
#   OpenRouter:    https://openrouter.ai/keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Paid (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local model (free, private). Install from https://ollama.com, then:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
