# Copy to .env.server (next to docker-compose.yml) and fill in.

# Your web address (for the https profile), e.g. mybrain.duckdns.org
BRAIN_DOMAIN=

# open = anyone can sign up · closed = only the admin can let people in (the first account is always allowed)
BRAIN_SIGNUP=open

# Cloudflare Tunnel token (for the tunnel profile)
TUNNEL_TOKEN=

# Optional: password-reset emails. Free options: Gmail with an app password, or Brevo (300 emails/day).
BRAIN_SMTP_HOST=
BRAIN_SMTP_PORT=587
BRAIN_SMTP_USER=
BRAIN_SMTP_PASSWORD=
BRAIN_SMTP_FROM=

# Optional: one FreeLLMAPI gateway for every user (start it with --profile freellmapi, add your free
# provider keys in its dashboard, copy its unified key here). Users can still add their own keys.
BRAIN_FREELLMAPI_URL=
BRAIN_FREELLMAPI_KEY=
